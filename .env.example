# Copy to .env on the server and fill in. .env is git-ignored.
Telegram__BotToken=
# Your Telegram user id: send /start, the id is printed in `docker compose logs`.
Bot__OwnerId=

OpenAI__ApiKey=

# OAuth client "Desktop app" from Google Cloud Console + refresh token from the gmail-auth CLI.
Gmail__ClientId=
Gmail__ClientSecret=
Gmail__RefreshToken=

# Optional: lets «📨 Подати на Djinni» submit applications. The "sessionid" cookie of a browser where you are
# logged in to Djinni; scripts/connect-djinni.ps1 checks it and writes it here. It is the key to your Djinni account.
Djinni__SessionId=
