<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>systematia-bot-4ade67a3-fdd4-46b9-a6f7-bbd47b48e8c3</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Telegram.Bot" Version="22.10.3.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SystematiaBot.Core\SystematiaBot.Core.csproj" />
    <ProjectReference Include="..\SystematiaBot.Infrastructure\SystematiaBot.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Shared runtime content lives at the repo root and is copied next to the binaries. -->
  <ItemGroup>
    <Content Include="..\..\config\**\*" LinkBase="config" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\prompts\**\*" LinkBase="prompts" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\demo\**\*" LinkBase="demo" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
